{
  "name": "imagine-labs",
  "version": "0.1.0",
  "description": "Cortex — local-first multi-agent coding orchestrator",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "bin": {
    "cortex": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm --dir dashboard build",
